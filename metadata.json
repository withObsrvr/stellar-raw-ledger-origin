    "archive_path": { "env": "ARCHIVE_PATH" },
    "ledgers_per_file": { "env": "LEDGERS_PER_FILE" },
    "files_per_partition": { "env": "FILES_PER_PARTITION" },
    "buffer_size": { "env": "BUFFER_SIZE" },
    "num_workers": { "env": "NUM_WORKERS" },
    "aws_region": { "env": "AWS_REGION" },
    "s3_endpoint_url": { "env": "S3_ENDPOINT_URL" },
    "storage_type": { "env": "STORAGE_TYPE" },
    "bucket_name": { "env": "BUCKET_NAME" },
    "bucket_path": { "env": "BUCKET_PATH" },
    "history_archive_urls": { "env": "HISTORY_ARCHIVE_URLS" },
    "stellar_core_binary_path": { "env": "STELLAR_CORE_BINARY_PATH" },
    "stellar_core_config_path": { "env": "STELLAR_CORE_CONFIG_PATH" },
    "captive_core_storage_path": { "env": "CAPTIVE_CORE_STORAGE_PATH" },
    "network_passphrase": { "env": "NETWORK_PASSPHRASE" },
