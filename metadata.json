    "end_ledger": { "env": "END_LEDGER" },
    "grpc_port": { "env": "GRPC_PORT" },
    "health_port": { "env": "HEALTH_PORT" },
    "flowctl_endpoint": { "env": "FLOWCTL_ENDPOINT" },
    "flowctl_component_id": { "env": "FLOWCTL_COMPONENT_ID" },
    "source_id": { "env": "SOURCE_ID" }
  },
  "env_mapping": {
